FROM python:3.10-slim
WORKDIR /app

# deps first
COPY requirements.txt ./requirements.txt
RUN pip install --upgrade pip && pip install --no-cache-dir -r requirements.txt

# app files
COPY .streamlit/ ./.streamlit/
COPY multi-qa-MiniLM-L6-cos-v1/ ./multi-qa-MiniLM-L6-cos-v1/
COPY backend_chatbot.py test_streamlit.py ./
COPY . /app

ENV STREAMLIT_CONFIG_FILE=./.streamlit/config.toml
EXPOSE 8501
CMD ["streamlit","run","test_streamlit.py","--server.port=8501","--server.address=0.0.0.0"]
